# ============================================================
# .gitignore для Retail Management System (Go + React)
# ============================================================

# ----------------------------------------
# Go
# ----------------------------------------

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Dependency directories
vendor/
go.sum

# Go workspace file
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Binary output
/bin/
/dist/
/build/
/tmp/

# Coverage
*.coverprofile
coverage.out
coverage.html

# Environment files
.env
.env.local
.env.*.local
.env.production

# Logs
*.log
logs/
log/

# Backend specific
backend/cmd/main
backend/cmd/*/main
backend/*.sqlite
backend/*.db
backend/*.pid

# ----------------------------------------
# Frontend (React + TypeScript + Tailwind)
# ----------------------------------------

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
out/
.next/
.nuxt/

# Environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Cache
.cache/
.parcel-cache/
.vite/
.turbo/

# Misc
*.log
*.tmp
*.temp
*.bak

# ----------------------------------------
# Docker
# ----------------------------------------

# Docker volumes
docker-data/
*.pid

# ----------------------------------------
# OS
# ----------------------------------------

.DS_Store
Thumbs.db
Desktop.ini

# ----------------------------------------
# Custom
# ----------------------------------------

# Local secrets
*.pem
*.key
*.crt
*.p12

# Temporary files
*.tmp
*.temp

# Backup files
*.backup
*.bak
*.old

# Test artifacts
*.test
*.test.log

# Profiles
profile
