# === Общие ===
APP_ENV=dev
TZ=Europe/Moscow

# === Postgres (docker-compose сервис pg) ===
POSTGRES_DB=retail
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
POSTGRES_PORT=5432
DATABASE_URL=postgres://retail:retail@localhost:5432/retail?sslmode=disable

# === Redis (docker-compose сервис redis) ===
REDIS_PORT=6379
REDIS_ADDR=localhost:6379

# === Backend ===
BACKEND_PORT=8080
JWT_SECRET=change-me-dev-secret-min-32-chars
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Шифрование секретов интеграций (AES-256-GCM, base64 32 байта или строка 32 байта).
# Сгенерировать: openssl rand -base64 32
# Без ключа backend стартует с dev-ключом (НЕ для продакшена).
SETTINGS_ENC_KEY=

# Сид супер-админа при старте (если пользователей нет).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

# Интервалы воркеров, секунды (0/пусто = дефолты).
OFD_WORKER_INTERVAL_SEC=2
BOOKING_REMIND_SEC=60

# === Frontend ===
VITE_API_URL=http://localhost:8080/api/v1

# === Prod (docker-compose.prod.yml) ===
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=change-me
# GRAFANA_PORT=3000
# SWAGGER_PORT=8081

# === Бэкапы (scripts/backup.sh) ===
# BACKUP_DIR=./backups
# BACKUP_KEEP=7
# PG_CONTAINER=retail-pg
