# === Общие ===
APP_ENV=dev
TZ=Europe/Moscow

# === Postgres (docker-compose сервис pg) ===
POSTGRES_DB=retail
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
POSTGRES_PORT=5432
DATABASE_URL=postgres://retail:retail@localhost:5432/retail?sslmode=disable

# === Redis (docker-compose сервис redis) ===
REDIS_PORT=6379
REDIS_ADDR=localhost:6379

# === Backend ===
BACKEND_PORT=8080
JWT_SECRET=change-me-dev-secret-min-32-chars
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# === Frontend ===
VITE_API_URL=http://localhost:8080/api/v1
